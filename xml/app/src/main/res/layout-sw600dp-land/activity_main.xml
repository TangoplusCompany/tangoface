<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.MainActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/flMain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bnv"
            app:layout_constraintTop_toTopOf="parent"></FrameLayout>

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/bnv"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="@drawable/color_gradation_bg_alpha"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:itemActiveIndicatorStyle="@style/App.CustomIndicator"
            app:itemIconSize="36dp"
            app:itemIconTint="@color/bnb_icon_color"
            app:itemPaddingBottom="20dp"
            app:itemPaddingTop="20dp"
            app:itemRippleColor="@color/accent10"
            app:itemTextAppearanceActive="@style/App.BottomNavText"
            app:itemTextAppearanceInactive="@style/App.BottomNavText"
            app:itemTextColor="@color/white"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:menu="@menu/bottom_nav_menu"
            app:menuGravity="center" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>