<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="11dp" />
            <solid android:color="@color/bg700" />
            <stroke
                android:width="1dp"
                android:color="@color/accent800" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="11dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/accent600"
                    android:centerColor="@color/accent"
                    android:endColor="@color/accent300"
                    android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
