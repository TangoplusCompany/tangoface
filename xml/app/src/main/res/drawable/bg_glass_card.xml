<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />

    <!-- 깊이감 있는 다크 와인-블랙 글래스 그라데이션 -->
    <gradient
        android:angle="270"
        android:startColor="@color/accent800"
        android:centerColor="#1E1E22"
        android:endColor="#141416"
        android:type="linear" />

    <!-- 은은한 핑크빛 외곽선 -->
    <stroke
        android:width="1dp"
        android:color="#4DFF516F" /> <!-- accent400 기반 30% 반투명 테두리 -->
</shape>