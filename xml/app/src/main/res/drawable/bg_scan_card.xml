<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />

    <!-- 심플한 다크 카드 배경 + 은은한 accent 계열 외곽선 -->
    <gradient
        android:angle="270"
        android:startColor="@color/bg500"
        android:endColor="@color/bg700"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="@color/accent800" />
</shape>
