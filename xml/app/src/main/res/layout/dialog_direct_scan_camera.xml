<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg700">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <!-- 상단 헤더 바 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDirectTopBar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvDirectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="태블릿 직접 3D 촬영"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Colab 서버 상태 뱃지 -->
            <TextView
                android:id="@+id/tvWorkerHealthBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_scan_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="서버 상태 확인 중..."
                android:textColor="@color/subColor300"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvDirectTitle"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDirectGuide"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_scan_card"
                android:paddingHorizontal="14dp"
                android:text="촬영 가이드"
                android:textColor="@color/subColor100"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCloseDirectScan"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCloseDirectScan"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_scan_card"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 1. 카메라 촬영 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDirectCameraContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clDirectTopBar">

            <!-- 3:4 카메라 프리뷰 박스 (높이 기준으로 3:4 폭 자동 맞춤 -> 하단 버튼 영역 항상 보장) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvCameraPreview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toTopOf="@id/llCameraControls"
                app:layout_constraintDimensionRatio="W,3:4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/pvDirectCamera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 상단 파노라마 스윕 게이지 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.tangoplus.tangoface.ui.view.ScanSweepTrackView
                        android:id="@+id/sweepTrackView"
                        android:layout_width="280dp"
                        android:layout_height="44dp" />

                    <TextView
                        android:id="@+id/tvSweepGuide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_scan_card"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="얼굴 좌측(-60°)을 바라본 상태에서 촬영을 시작하세요"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 녹화 타이머 뱃지 -->
                <TextView
                    android:id="@+id/tvRecordTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_scan_card"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="● REC 00:00 / 00:30"
                    android:textColor="@color/accent300"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </androidx.cardview.widget.CardView>

            <!-- 하단 촬영 제어 바 -->
            <LinearLayout
                android:id="@+id/llCameraControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPickVideoFile"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_scan_card"
                    android:paddingHorizontal="18dp"
                    android:text="영상 파일 첨부"
                    android:textColor="@color/subColor100"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRecordToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:background="@drawable/effect_glass_card_accent"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="32dp"
                    android:text="● 녹화 시작"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_scan_card"
                    android:paddingHorizontal="18dp"
                    android:text="카메라 전환"
                    android:textColor="@color/subColor100"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. 촬영/선택 영상 3:4 미리보기 및 업로드 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDirectPreviewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clDirectTopBar"
            tools:visibility="gone">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvVideoPreview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toTopOf="@id/tvPreviewMeta"
                app:layout_constraintDimensionRatio="W,3:4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <VideoView
                    android:id="@+id/vvDirectPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvPreviewMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="@color/subColor300"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@id/llUploadProgress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="영상 길이: 12.4초 · 파일 크기: 15.8 MB" />

            <LinearLayout
                android:id="@+id/llUploadProgress"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/llPreviewControls"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvUploadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="영상 전송 중..."
                    android:textColor="@color/accent300"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbUploadProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_round_progress" />

                <TextView
                    android:id="@+id/tvUploadPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0%"
                    android:textColor="@color/subColor300"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPreviewControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRetakeVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_scan_card"
                    android:paddingHorizontal="20dp"
                    android:text="다시 촬영"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveLocalVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_scan_card"
                    android:paddingHorizontal="20dp"
                    android:text="영상 저장하기"
                    android:textColor="@color/subColor100"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUploadVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/effect_glass_card_accent"
                    android:paddingHorizontal="28dp"
                    android:text="3D 모델 생성하기"
                    android:textColor="@color/subColor100"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3단계 촬영 가이드 오버레이 (상단 '촬영 가이드' 버튼으로 열기) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clDirectGuideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scan_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="520dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D 얼굴 직접 촬영 가이드"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="6dp"
                android:text="1. 피촬영자는 정면을 바라보고 움직이지 않도록 안내하세요.\n\n2. 얼굴 좌측(-60°)에서 촬영 시작 버튼을 누른 뒤, 상단 게이지를 보며 정면을 지나 우측(+60°)까지 120° 원호를 따라 천천히 이동하세요.\n\n3. 게이지가 100%(민트색)에 도달하면 촬영 종료를 누르고 3D 모델 생성을 시작하세요."
                android:textColor="@color/subColor300"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirmDirectGuide"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/effect_glass_card_accent"
                android:paddingHorizontal="36dp"
                android:text="확인했습니다"
                android:textColor="@color/subColor100"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

