<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.measure.ModelScanFragment">

    <!-- 메인 콘텐츠 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 상단 헤더 바 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTopBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 좌측 상단: TangoFace + 실험실 뱃지 -->
            <LinearLayout
                android:id="@+id/llBrandContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TangoFace"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLabBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/effect_20"
                    android:backgroundTint="@color/accent"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="실험실"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 우측 영역: 3D 모델링 스캔 타이틀 -->
            <LinearLayout
                android:id="@+id/llRightHeaderContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvScanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D 얼굴 스캔"
                    android:textColor="@color/subColor100"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 1. QR 스캔 및 1초 뒤 PIN 번호 발급 영역 (READY_TO_SCAN / CREATED / PAIRED) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPairingContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="60dp"
            android:layout_marginVertical="60dp"
            android:background="@drawable/bg_scan_card"
            android:padding="20dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clTopBar"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvPairingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="스마트폰 카메라로 아래 QR 코드를 스캔해주세요"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 스마트폰 스캔용 QR 코드 이미지 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvQrWrapper"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPairingTitle">

                <ImageView
                    android:id="@+id/ivScanQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:contentDescription="스캔용 QR 코드"
                    android:padding="10dp"
                    android:src="@drawable/img_scan_qr" />

            </androidx.cardview.widget.CardView>

            <!-- 1초 동안 PIN 발급 대기 프로그레스 -->
            <ProgressBar
                android:id="@+id/pbPinLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/accent300"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvQrWrapper" />

            <!-- 1초 뒤 발급되는 6자리 PIN 번호 -->
            <TextView
                android:id="@+id/tvPairingCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.25"
                android:textColor="@color/subColor100"
                android:textSize="58sp"
                android:textStyle="bold"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvQrWrapper"
                tools:text="829143" />

            <TextView
                android:id="@+id/tvPairingSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="스마트폰 화면에 위 6자리 번호를 입력해주세요\n모델링 서버 시동에 최대 5분이 소요됩니다\n모델 생성은 약 1분, 측정에 약 5분 소요예정입니다."
                android:textColor="@color/subColor500"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPairingCode" />

            <LinearLayout
                android:id="@+id/llDirectScanActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUploadVideoFile"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_scan_card"
                    android:paddingHorizontal="20dp"
                    android:text="영상 파일 업로드"
                    android:textColor="@color/subColor100"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDirectCapture"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/effect_glass_card_accent"
                    android:paddingHorizontal="22dp"
                    android:text="직접 촬영"
                    android:textColor="@color/subColor100"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. 실시간 3D 복원 진행률 및 남은 시간 영역 (status == PROCESSING / UPLOADED) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clProgressContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="60dp"
            android:background="@drawable/bg_scan_card"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clTopBar"
            tools:visibility="gone">

            <TextView
                android:id="@+id/tvProgressStage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D 얼굴 복원을 진행 중입니다..."
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/pbScanProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginTop="28dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_round_progress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvProgressStage"
                tools:progress="45" />

            <TextView
                android:id="@+id/tvRemainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/accent100"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pbScanProgress"
                tools:text="예상 남은 시간: 약 25초" />

            <!-- 3초 뒤 측정자 정보 입력 자동 실행 안내 -->
            <TextView
                android:id="@+id/tvUserSetupHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/accent300"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRemainingTime"
                tools:text="3초 뒤 측정자 정보 입력을 시작합니다..."
                tools:visibility="visible" />

            <!-- 100초 경과 후 나타나는 대기 취소/초기화 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelBaking"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_scan_card"
                android:paddingHorizontal="28dp"
                android:text="대기 취소"
                android:textColor="@color/subColor100"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUserSetupHint"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. 복원 완료 안내 영역 (status == DONE) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDoneContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="60dp"
            android:background="@drawable/bg_glass_card"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clTopBar"
            tools:visibility="gone">

            <TextView
                android:id="@+id/tvDoneTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D 얼굴 복원 완료!"
                android:textColor="@color/subColor100"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDoneMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="복원 완료! 3D 모델을 준비합니다."
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDoneTitle" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewScanResult"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/effect_glass_card_accent"
                android:paddingHorizontal="36dp"
                android:text="결과 보기"
                android:textColor="@color/subColor100"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDoneMessage"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 우측 하단: 태블릿 직접 촬영 & 영상 파일 업로드 버튼 2개 -->

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
