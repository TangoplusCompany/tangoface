<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg700"
    tools:context=".ui.info.IModelScanFragment">

    <!-- 3D GLB 모델 렌더링용 WebView -->
    <WebView
        android:id="@+id/wvIModelScanViewer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- DB 저장 측정 날짜 표시 -->
    <TextView
        android:id="@+id/tvIModelScanDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:textColor="@color/subColor300"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2026-11-11 13:20:00" />

    <!-- 로딩 및 오류 상태 안내 -->
    <TextView
        android:id="@+id/tvIModelScanStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3D 모델을 불러오는 중..."
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 우측 하단 3D 뷰어 제어 버튼 그룹 (INormal / IExpert 스타일) -->
    <LinearLayout
        android:id="@+id/llModelScanControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="30dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <!-- 1. 굴곡 보기 (단색 입체 모드 / 원래 색상) -->
        <TextView
            android:id="@+id/btnToggleClayMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:background="@drawable/effect_20"
            android:backgroundTint="@color/accent800"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text=" 굴곡 보기"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 2. 조명 밝기 순환 (보통 -> 밝게 -> 최대 -> 은은하게) -->
        <TextView
            android:id="@+id/btnToggleBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:background="@drawable/effect_20"
            android:backgroundTint="@color/accent800"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text=" 밝기: 보통"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 3. 360도 회전 모드 토글 -->
        <TextView
            android:id="@+id/btnToggleFreeRotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:background="@drawable/effect_20"
            android:backgroundTint="@color/accent800"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text=" 360° 회전"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 4. 정면 보기 리셋 -->
        <TextView
            android:id="@+id/btnResetView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/effect_20"
            android:backgroundTint="@color/accent800"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="정면 보기"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
