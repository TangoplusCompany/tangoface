<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg700"
    tools:context=".ui.info.IModelScanFragment">

    <!-- 3D GLB 모델 렌더링용 WebView -->
    <WebView
        android:id="@+id/wvIModelScanViewer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- DB 저장 측정 날짜 표시 -->
    <TextView
        android:id="@+id/tvIModelScanDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:textColor="@color/subColor300"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2026-11-11 13:20:00" />

    <!-- 컬러 / 단색(입체) 메쉬 전환 버튼 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnToggleClayMode"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_scan_card"
        android:paddingHorizontal="18dp"
        android:text="입체 모형"
        android:textColor="@color/subColor100"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- 로딩 및 오류 상태 안내 -->
    <TextView
        android:id="@+id/tvIModelScanStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3D 모델을 불러오는 중..."
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
