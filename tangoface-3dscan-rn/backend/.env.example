# Supabase Configuration (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Security Salts & Webhook Secrets
IP_HASH_SALT=your_random_secret_salt_for_ip_hashing_32_chars_minimum
RUNPOD_WEBHOOK_SECRET=your_runpod_webhook_secret_key
CRON_SECRET=your_vercel_cron_secret_key

# CORS Settings (comma-separated, NO wildcards!)
ALLOWED_ORIGINS=http://localhost:8081,https://tangoface.com

# Tablet Device Authentication Key
TABLET_API_KEY=your_secure_tablet_api_key_here

# Colab FastAPI Worker Authentication & Optional Fallback URL
WORKER_SECRET=your_colab_worker_secret_key
WORKER_REGISTER_SECRET=your_colab_worker_register_secret_key
COLAB_WORKER_URL=
