<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Tangoface_compose" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- alertdialog theme 적용 -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/black</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:background">@color/white</item>
        <item name="android:windowBackground">@color/subColor100</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.App.Body.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button</item>
    </style>

    <style name="CustomSwitchStyle" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_color</item>
        <item name="trackDecorationTint">@color/switch_track_color</item>
        <item name="thumbTint">@color/switch_thumb_color</item>
    </style>

</resources>
