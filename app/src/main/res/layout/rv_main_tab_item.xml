<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   android:layout_width="200dp"
                                                   android:layout_height="128dp"
                                                   android:layout_marginEnd="20dp"
                                                   android:background="@drawable/bckgnd_64"
                                                   android:backgroundTint="@color/bg300"
                                                   android:paddingStart="30dp"
                                                   android:paddingEnd="30dp">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/ivMTI"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="10dp" android:textSize="48sp"
            android:text="☀️"/>
    <TextView
            android:text="페이스 보우 측정"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/tvMTITitle"
            app:layout_constraintTop_toBottomOf="@+id/ivMTI" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="10dp" android:textSize="18sp"
            android:textColor="@color/subColor100"/>
</androidx.constraintlayout.widget.ConstraintLayout>