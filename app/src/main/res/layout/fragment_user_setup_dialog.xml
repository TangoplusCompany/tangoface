<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flUSD"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.measure.UserSetupDialogFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg">

            <TextView
                android:id="@+id/tvUSDSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:padding="6dp"
                android:text="SKIP"
                android:textColor="@color/subColor100"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tvUSDGuide"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvUSDGuide" />

            <TextView
                android:id="@+id/tvUSDGuide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text="안녕하세요\n분석을 위해 성함을 입력해주세요"
                android:textColor="@color/subColor100"
                android:textSize="18sp"
                app:layout_constraintEnd_toStartOf="@+id/tvUSDSkip"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etUSDName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/accent"
                android:ems="10"
                android:hint="이름"
                android:inputType="text"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:singleLine="true"
                android:textColor="@color/subColor100"
                android:textColorHint="@color/subColor100"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvUSDGuide" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvUSDNameGuide"
                    app:layout_constraintTop_toBottomOf="@+id/etUSDName"
                    app:layout_constraintStart_toStartOf="@+id/etUSDName" android:layout_marginTop="5dp"
                    android:textColor="@color/subColor100" android:text="이름: 한국어(2-5자), 영어(2-20자)만 사용가능합니다."
                    android:visibility="gone"/>
            <EditText
                    android:id="@+id/etUSDMobile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:backgroundTint="@color/accent"
                    android:ems="10"
                    android:hint="휴대폰 번호"
                    android:inputType="phone"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:singleLine="true"
                    android:textColor="@color/subColor100"
                    android:textColorHint="@color/subColor100"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvUSDNameGuide" android:layout_marginTop="10dp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvUSDMobileGuide"
                    android:textColor="@color/subColor100" app:layout_constraintTop_toBottomOf="@+id/etUSDMobile"
                    app:layout_constraintStart_toStartOf="@+id/etUSDMobile"
                    android:text="휴대전화번호: 010으로 시작하는 휴대폰 번호를 정확히 입력해주세요" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUSDProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/effect_0"
                android:backgroundTint="@color/accent"
                android:padding="12sp"
                android:text="사전 체크리스트 시작"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clUSDGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvUSDMobileGuide" android:layout_marginTop="10dp">

                <TextView
                        android:id="@+id/textView20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="성별"
                        android:textColor="@color/subColor100"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView20">

                    <TextView
                            android:id="@+id/tvUSDGender0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/effect_20"
                            android:backgroundTint="@color/bg500"
                            android:elevation="2dp"
                            android:gravity="center"
                            android:paddingTop="20dp"
                            android:paddingBottom="20dp"
                            android:text="남성"
                            android:textColor="@color/subColor100"
                            android:textSize="16sp"/>

                    <TextView
                            android:id="@+id/tvUSDGender1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/effect_20"
                            android:backgroundTint="@color/bg500"
                            android:elevation="2dp"
                            android:gravity="center"
                            android:paddingTop="20dp"
                            android:paddingBottom="20dp"
                            android:text="여성"
                            android:textColor="@color/subColor100"
                            android:textSize="16sp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clUSDAgeRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clUSDGender">

                <LinearLayout
                    android:id="@+id/linearLayout5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="생년월일"
                        android:textColor="@color/subColor100"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/textView14"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="국적"
                        android:textColor="@color/subColor100"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout5">

                    <TextView
                        android:id="@+id/tvUSDBirthday"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/effect_20"
                        android:backgroundTint="@color/bg500"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:text="날짜 선택"
                        android:textColor="@color/subColor100"
                        android:textSize="16sp" />

                    <com.hbb20.CountryCodePicker
                        android:id="@+id/ccpUSD"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/effect_20"
                        android:backgroundTint="@color/bg500"
                        android:elevation="2dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        app:ccpDialog_textColor="@color/subColor100"
                        app:ccp_arrowColor="@color/subColor100"
                        app:ccp_contentColor="@color/subColor100"
                        app:ccp_textSize="16sp" />


                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>