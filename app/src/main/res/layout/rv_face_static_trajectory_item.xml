<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:background="@drawable/bckgnd_12"
    android:backgroundTint="@color/bg700">

    <com.tangoplus.tangoface.ui.view.TrajectoryView
        android:id="@+id/trvFSTI"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_margin="15dp"
        android:background="@drawable/bckgnd_12"
        android:backgroundTint="@color/bg500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.4" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/trvFSTI"
        app:layout_constraintEnd_toEndOf="@+id/trvFSTI"
        app:layout_constraintStart_toStartOf="@+id/trvFSTI"
        app:layout_constraintTop_toTopOf="@+id/trvFSTI"
        app:srcCompat="@drawable/line_dash_horizontal" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/trvFSTI"
        app:layout_constraintEnd_toEndOf="@+id/trvFSTI"
        app:layout_constraintStart_toStartOf="@+id/trvFSTI"
        app:layout_constraintTop_toTopOf="@+id/trvFSTI"
        app:srcCompat="@drawable/line_dash_vertical" />

    <TextView
        android:id="@+id/tvFSTIReplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:drawableEnd="@drawable/ic_refresh"
        android:gravity="center_vertical"
        android:padding="2dp"
        android:text="처음부터"
        android:textColor="@color/accent300_80"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="@+id/trvFSTI"
        app:layout_constraintTop_toTopOf="@+id/trvFSTI" />

    <TextView
        android:id="@+id/tvFSTIName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="턱 왼쪽 이동 후 입 벌림"
        android:textColor="@color/subColor100"
        android:textSize="20dp"
        app:layout_constraintStart_toEndOf="@+id/trvFSTI"
        app:layout_constraintTop_toTopOf="@+id/trvFSTI" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:text="궤적을 클릭하면 일시정지/재생할 수 있습니다"
        android:textColor="@color/subColor500"
        android:textSize="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvFSTIName"
        app:layout_constraintTop_toBottomOf="@+id/tvFSTIName" />

    <TextView
        android:id="@+id/tvFSTIData1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:text="총 이동 시간"
        android:textColor="@color/subColor100"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvFSTIName"
        app:layout_constraintTop_toBottomOf="@+id/tvFSTIName" />

    <TextView
        android:id="@+id/tvFSTIData2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:text="턱 가측 이동 거리: "
        android:textColor="@color/subColor100"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvFSTIData1"
        app:layout_constraintTop_toBottomOf="@+id/tvFSTIData1" />

    <TextView
        android:id="@+id/tvFSTIData3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:text="턱 가측 이동 시간:"
        android:textColor="@color/subColor100"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvFSTIData2"
        app:layout_constraintTop_toBottomOf="@+id/tvFSTIData2" />

    <TextView
        android:id="@+id/tvFSTIData4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:text="턱 개구 시간"
        android:textColor="@color/subColor100"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvFSTIData3"
        app:layout_constraintTop_toBottomOf="@+id/tvFSTIData3" />

    <TextView
        android:id="@+id/tvFSTIData5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:text="턱 개구 이동 시간"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvFSTIData4"
        app:layout_constraintTop_toBottomOf="@+id/tvFSTIData4" />

</androidx.constraintlayout.widget.ConstraintLayout>