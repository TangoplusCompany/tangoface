<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.measure.TextInputDialogFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bckgnd_20"
        android:backgroundTint="@color/subColor100">

        <EditText
            android:id="@+id/etTID"
            android:layout_width="512dp"
            android:layout_height="128dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bckgnd_12"
            android:backgroundTint="@color/white"
            android:ems="10"
            android:gravity="start|top"
            android:inputType="text"
            android:maxLength="64"
            android:maxLines="1"
            android:padding="12dp"
            android:singleLine="true"
            android:text="Name"
            app:layout_constraintBottom_toTopOf="@+id/llFSI101"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/ibtnTIDClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/effect_20"
            android:padding="4dp"
            android:src="@drawable/ic_input_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/llFSI101"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/etTID"
            app:layout_constraintStart_toStartOf="@+id/etTID">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTIDCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/effect_bottom_left_20"
                android:backgroundTint="@color/black"
                android:stateListAnimator="@null"
                android:text="취소"
                android:textColor="@color/white"
                android:textSize="18dp" />

            <androidx.appcompat.widget.AppCompatButton

                android:id="@+id/btnTIDConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_weight="1"
                android:background="@drawable/effect_bottom_right_20"
                android:backgroundTint="@color/black"
                android:stateListAnimator="@null"
                android:text="확인"
                android:textColor="@color/white"
                android:textSize="18dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>