<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMVI"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bckgnd_12"
        android:backgroundTint="@color/bg700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvUICircle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/effect_28"
            android:gravity="center"
            android:text="이"
            android:textColor="@color/subColor100"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMVIName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="4"
            android:gravity="center"
            android:text="이*휘"
            android:textColor="@color/subColor100"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tvUICircle"
            app:layout_constraintStart_toEndOf="@+id/tvUICircle"
            app:layout_constraintTop_toTopOf="@+id/tvUICircle" />

        <TextView
            android:id="@+id/tvMVIAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="만 30세"
            android:textColor="@color/subColor100"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvMVIName"
            app:layout_constraintStart_toEndOf="@+id/tvMVIName"
            app:layout_constraintTop_toTopOf="@+id/tvMVIName" />

        <TextView
            android:id="@+id/tvMVIGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLength="25"
            android:maxLines="1"
            android:text="남성"
            android:textColor="@color/subColor100"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvMVIAge"
            app:layout_constraintStart_toEndOf="@+id/tvMVIAge"
            app:layout_constraintTop_toTopOf="@+id/tvMVIAge" />

        <TextView
            android:id="@+id/tvMVIType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bckgnd_12"
            android:backgroundTint="@color/accent"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="비대칭 진단"
            android:textColor="@color/subColor100"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvMVIGender"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvMVIGender" />
        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUICircle">

            <TextView
                android:id="@+id/tvMVIRegDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.45"
                android:text="🗓️: "
                android:textColor="@color/subColor100"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMVIMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.55"
                android:text="📱: "
                android:textColor="@color/subColor100"
                android:textSize="16sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>